# Rakshak AI — Environment Variables Template
# Copy this file to backend/.env and frontend/.env as needed

# AI / LLM Configuration (Optional: system runs fully offline when DEMO_MODE=true)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Demo Mode (true enables offline heuristic engine and sample scenarios without external API calls)
DEMO_MODE=true

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./rakshak.db

# Frontend Configuration (for frontend/.env)
VITE_API_BASE_URL=http://localhost:8001
VITE_DEMO_MODE=true
